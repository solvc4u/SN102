# =============================================================================
# SN102 mining environment — copy to /root/SN102/ops/.env and fill in.
#   cp /root/SN102/ops/env.template /root/SN102/ops/.env && chmod 600 /root/SN102/ops/.env
# Never commit this file. launch.sh sources it.
# =============================================================================

# --- Machine identity -------------------------------------------------------
# Public IP of this box, published in the on-chain axon record by serve_axon().
# Nothing dials this axon (submission is HF + chain commit) but the extrinsic
# must not carry a stale address from a previous host.
CONNITO_PUBLIC_IP=47.233.59.142

# --- HuggingFace: ONE TOKEN PER MINER ---------------------------------------
# Read the note in ops/README-429.md before deciding how to fill these.
# HF rate limits are enforced primarily PER TOKEN, secondarily per IP. Three
# miners sharing one token will 429 on upload no matter what proxy you route
# through. Use three separate HF accounts.
#
# Each repo must be PUBLIC (validators pull with a stock read token; a private
# repo gives them 401 -> your eval_status_label becomes download_failed) and
# the repo id must be <= 32 characters (CHAIN_COMMIT_MAX_HF_REPO_ID_CHARS).
HF_TOKEN_UID121=
HF_TOKEN_UID178=
HF_TOKEN_UID250=

HF_REPO_UID121=
HF_REPO_UID178=
HF_REPO_UID250=

# Token used only by fetch_corpus.py for the one-time shared corpus download.
# Can be any of the above, or a fourth read-only token.
HF_TOKEN_CORPUS=

# --- Per-miner egress proxy (optional) --------------------------------------
# Leave blank to go direct. If set, only that miner's HF traffic is routed
# through it. Format: http://user:pass@host:port  or  socks5://host:port
# This spreads source IPs across the three uploaders; it does NOT fix a shared
# token (see ops/README-429.md).
PROXY_UID121=
PROXY_UID178=
PROXY_UID250=

# --- Paths ------------------------------------------------------------------
CONNITO_ROOT=/root/SN102/Connito
OPS_ROOT=/root/SN102/ops
# Shared corpus, written once by fetch_corpus.py, read by all three miners.
CORPUS_DIR=/root/SN102/data/corpus
# LOCKED to exp_legal by TaskCfg._LOCKED_FIELDS. Do not change.
EXPERT_GROUP=exp_legal
# Shared HF hub cache for the DeepSeek-V2-Lite backbone + global checkpoints.
# All three miners share this so the backbone is downloaded once, not 3x.
HF_HOME=/root/SN102/data/hf
HF_HUB_ENABLE_HF_TRANSFER=1

# --- Wallet -----------------------------------------------------------------
COLDKEY_NAME=Apollo
HOTKEY_UID121=miner1
HOTKEY_UID178=miner2
HOTKEY_UID250=miner5

# --- Tuning state -----------------------------------------------------------
# sqlite db of (cycle, uid, lr, warmup, probe_loss, observed val_loss).
# autolr.py reads this to pick the next cycle's LR.
TUNER_DB=/root/SN102/data/tuner.sqlite
# GPU reserved for offline LR search; not used by any registered miner.
SEARCH_GPU=3
