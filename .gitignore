# Secrets — HF tokens, hotkey names, proxy URLs. NEVER commit.
ops/.env
**/.env
*.key
*.pem

# Upstream repo, vendored separately (see v*/connito-patches for our diffs)
Connito/

# Data and artefacts: ~450 GB, all regenerable
data/
logs/
venv/
archive/
patches/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Local scratch
*.bak
*.swp
*.tmp

# Stashed launch commands — contain HF tokens in the env block
ops/.cmds/

# Any .env variant, including timestamped backups. ops/.env.bak.* reached a
# commit once and was caught by GitHub push protection, not by this file.
ops/.env*
**/.env*
