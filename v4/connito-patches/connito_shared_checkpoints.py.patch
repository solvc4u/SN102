diff --git a/connito/shared/checkpoints.py b/connito/shared/checkpoints.py
index 58bc9a1..519a591 100644
--- a/connito/shared/checkpoints.py
+++ b/connito/shared/checkpoints.py
@@ -584,6 +584,36 @@ def _local_checkpoint_meta(path: Path) -> dict[str, Any] | None:
     if "globalver" not in meta and "inneropt" not in meta:
         return None
 
+    # LOCAL PATCH (ops/): an EMPTY checkpoint directory is not a checkpoint.
+    #
+    # global_ver is parsed straight out of the directory name, so a directory is
+    # a provenance record. A failed download leaves the name behind with nothing
+    # in it, and the miner then adopts that version as its own:
+    #
+    #   uid_108_..._globalver_8766356/   files=0   4.0K   <- download failed
+    #   uid_0_..._globalver_8765832/     files=1   3.4G   <- what we actually hold
+    #   miner reports global_ver=8766356
+    #
+    # Every chain commit today advertised 8766356 while training on 8765832
+    # weights, i.e. we told validators we trained from a checkpoint we never
+    # obtained. If a validator cross-checks the advertised version against the
+    # model hash, that alone is grounds to score us badly or skip us.
+    #
+    # Directories are only rejected when they exist and are empty; a path that
+    # cannot be listed is left alone so this can never mask a real checkpoint
+    # behind a transient stat error.
+    if path.is_dir():
+        try:
+            has_payload = any(
+                p.name != ".cache" and not p.name.startswith(".")
+                for p in path.iterdir()
+            )
+        except OSError:
+            has_payload = True
+        if not has_payload:
+            logger.debug("ignoring empty checkpoint directory", path=str(path))
+            return None
+
     return meta
 
 
