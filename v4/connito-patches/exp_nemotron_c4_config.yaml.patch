   world_size: 10 # TODO: approximately how many miners are out there
   rank: 1 # TODO: based on your uid
 
-  # NOTE: `dataset_class` is deliberately NOT set. Leaving it unset resolves to
+  # LOCAL CORPUS — kept. Validator evidence, 2026-08-03:
+  #     uid 178 (local, 1.2e-5): 2.5476 -> 2.3715   improved
+  #     uid 250 (streaming, 3e-5): 2.7424           worse
+  #
+  # An earlier revert was nearly made on the basis of 178's LOCAL eval jumping
+  # 2.52 -> 3.33. That comparison was invalid: setting `dataset_class` also moves
+  # the EVAL split onto the local corpus, so the two numbers were measured on
+  # different distributions. Only the validator's seeded slice scores, and by
+  # that measure local is our best configuration so far.
+  #
+  # Known defect, still worth fixing: ops/fetch_corpus.py takes rows
+  # head-of-stream, so 4M rows cover only ~11 of c4's 1024 source shards (~1%),
+  # while `eval_source_seeded_shard_pick` draws uniformly from all of them. Same
+  # bias that produced a 93% Czech/Bulgarian legal corpus; ops/fetch_legal_native.py
+  # fixes it with per-shard quotas. Rebuilding the corpus that way should widen
+  # coverage without giving up the stability that is currently winning.
+  #
+  # ORIGINAL UPSTREAM NOTE:
+  # `dataset_class` is deliberately NOT set. Leaving it unset resolves to
   # `DefaultStreamingTorchDataset`, whose `tokenize_and_format` delegates to
   # `connito.shared.dataloader.tokenize_windowed` — long documents contribute a
   # content-hash-derived window instead of always their (most templated) prefix.
   # `expert_groups/exp_math/dataset.py` still prefix-truncates, so pointing at it
   # would silently drop that anti-memorization fix.
+  dataset_class: "ops.shared_dataset:LocalSharedDataset"
 
   # Whole-shard eval reach: seed picks the shard AND the in-shard offset, so
   # across rotating seeds every shard and every row is eventually reachable.
